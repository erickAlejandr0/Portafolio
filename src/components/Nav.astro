---
import Icon from './Icon.astro';
import { href, site } from '../data/site';

const links = [
  { label: 'Sobre mí', path: '#sobre-mi' },
  { label: 'Habilidades', path: '#habilidades' },
  { label: 'Proyectos', path: '#proyectos' },
  { label: 'Trayectoria', path: '#trayectoria' },
];
---

<header class="nav">
  <div class="nav__bar">
    <a class="nav__brand" href={href()} aria-label={`${site.name}, inicio`}>
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <path d="M20 40 32 18l12 22" fill="none" stroke="#668BC4" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="32" cy="18" r="5" fill="#7F9FD0" />
        <circle cx="20" cy="40" r="5" fill="#668BC4" />
        <circle cx="44" cy="40" r="5" fill="#6FB38F" />
      </svg>
      {site.name}
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <span data-open><Icon name="menu" /></span>
      <span data-close hidden><Icon name="close" /></span>
    </button>

    <nav id="menu" class="nav__menu" aria-label="Principal">
      {links.map((l) => <a class="nav__link" href={href(l.path)}>{l.label}</a>)}
      <a class="btn btn--primary nav__cta" href={href('#contacto')}>Contactar</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('menu');
  const iconOpen = toggle?.querySelector<HTMLElement>('[data-open]');
  const iconClose = toggle?.querySelector<HTMLElement>('[data-close]');

  function setOpen(open: boolean) {
    if (!toggle || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    iconOpen.hidden = open;
    iconClose.hidden = !open;
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
